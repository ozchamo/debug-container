FROM registry.access.redhat.com/ubi9/ubi:latest

# Install Apache (httpd), Python 3, OpenSSH client, ping (iputils), and mount utilities (util-linux)
RUN dnf --disableplugin=subscription-manager install -y \
    httpd \
    python3 \
    python3-pip \
    openssh-clients \
    iputils \
    util-linux \
    && dnf clean all

# Configure Apache for non-root execution:
# 1. Change Listen port to 8080 (non-privileged port)
# 2. Adjust directory permissions for Apache runtime, logs, and document root
RUN sed -i 's/^Listen 80/Listen 8080/' /etc/httpd/conf/httpd.conf && \
    mkdir -p /var/run/httpd /var/log/httpd /var/www/html && \
    chown -R apache:apache /run/httpd /var/run/httpd /var/log/httpd /var/www/html /etc/httpd && \
    chmod -R g+rwx /var/run/httpd /var/log/httpd /var/www/html 

# Create the custom index.html
RUN echo "<h1>Welcome to debug-container</h1>" > /var/www/html/index.html && \
    chown apache:apache /var/www/html/index.html

# Switch to the non-root 'apache' user (UID 48)
USER apache

# Expose the non-privileged port
EXPOSE 8080

# Start Apache in foreground
CMD ["/usr/sbin/httpd", "-D", "FOREGROUND"]
