FROM registry.access.redhat.com/ubi9/ubi:latest

# Install required tools and Apache (httpd)
RUN dnf install -y \
    bash \
    iputils \
    openssh-clients \
    util-linux \
    httpd \
    sed \
    && dnf clean all

# Configure Apache to run as a non-root user
# 1. Add PidFile directive
# 2. Change Listen port to 8080
# 3. Adjust permissions so standard non-root user (UID 1001) can run httpd
RUN echo "PidFile /tmp/httpd.pid" >> /etc/httpd/conf/httpd.conf && \
    sed -i 's/^Listen 80/Listen 8080/' /etc/httpd/conf/httpd.conf && \
    echo "<h1>Welcome to debug-container</h1>" > /var/www/html/index.html && \
    mkdir -p /var/log/httpd /run/httpd && \
    chown -R 1001:0 /etc/httpd /var/www/html /var/log/httpd /run/httpd /tmp && \
    chmod -R g=u /etc/httpd /var/www/html /var/log/httpd /run/httpd /tmp

# Switch to non-root user
USER 1001

EXPOSE 8080

CMD ["httpd", "-D", "FOREGROUND"]
