FROM registry.access.redhat.com/ubi9/ubi:latest

# Install Apache (httpd), Python 3, OpenSSH client, ping (iputils), and mount utilities (util-linux)
RUN dnf --disableplugin=subscription-manager install -y \
    httpd \
    python3 \
    python3-pip \
    openssh-clients \
    iputils \
    util-linux \
    && dnf clean all

# Configure httpd.conf:
# 1. Change Listen port from 80 to 8080
# 2. Add PidFile /tmp/httpd.pid directive
RUN sed -i 's/^Listen 80/Listen 8080/' /etc/httpd/conf/httpd.conf && \
    echo "PidFile /tmp/httpd.pid" >> /etc/httpd/conf/httpd.conf

# Create the custom index.html
RUN echo "<h1>Welcome to debug-container</h1>" > /var/www/html/index.html

# Expose port 8080
EXPOSE 8080

# Start Apache in the foreground
CMD ["/usr/sbin/httpd", "-D", "FOREGROUND"]
